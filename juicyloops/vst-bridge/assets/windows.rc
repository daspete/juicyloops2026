// Windows resources of juicyloops-bridge.exe, compiled in by build.rs: the icon Explorer, the taskbar and the console
// window show, and the version info of the file's Properties dialog. VERSION_NUMBERS and VERSION_TEXT come from
// build.rs (Cargo.toml's version).
#include <winver.h>

#define STRINGIFY_(text) #text
#define STRINGIFY(text) STRINGIFY_(text)

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Juicy Loops"
            VALUE "FileDescription", "Juicy Loops Bridge: plays your CLAP and VST3 plugins in the Juicy Loops studio"
            VALUE "FileVersion", STRINGIFY(VERSION_TEXT)
            VALUE "InternalName", "juicyloops-bridge"
            VALUE "OriginalFilename", "juicyloops-bridge.exe"
            VALUE "ProductName", "Juicy Loops Bridge"
            VALUE "ProductVersion", STRINGIFY(VERSION_TEXT)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
