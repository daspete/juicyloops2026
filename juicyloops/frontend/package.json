{
    "name": "@juicyloops/frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "corepack enable && vite",
        "build": "vite build && vite build --ssr src/entry-server.ts && node scripts/prerender/prerender.mjs",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "lint": "eslint . --fix",
        "format": "prettier --write src/",
        "check": "yarn type-check && yarn lint && yarn test:unit"
    },
    "dependencies": {
        "@breezystack/lamejs": "^1.2.7",
        "@iconify/vue": "^5.0.2",
        "@primeuix/themes": "^2.0.3",
        "@tailwindcss/vite": "^4.3.3",
        "primevue": "^4.5.5",
        "sass": "^1.104.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-primeui": "^0.6.1",
        "tone": "^15.1.22",
        "v-plausible": "^1.2.0",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "wavesurfer.js": "^7.12.12"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.10.0",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-vue": "^10.11.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.0",
        "prettier": "^3.9.8",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11"
    },
    "packageManager": "yarn@4.12.0"
}
