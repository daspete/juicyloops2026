{
  "name": "Juicy Loops",
  "short_name": "Juicy Loops",
  "description": "Make beats in your browser: a step sequencer with synths, samples and your voice. Free, no signup.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14111f",
  "theme_color": "#14111f",
  "icons": [
    { "src": "/favicon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
